NODE_ENV=production
PORT=3000

SITE_HOST=92-222-70-138.sslip.io
# Email pour Let's Encrypt (notifs d'expiration). Mets une vraie adresse.
ACME_EMAIL=toi@exemple.fr

# URL publique HTTPS de l'API = https:// + SITE_HOST. Sert à construire les
# `photoUrl` renvoyées par les endpoints de scan.
APP_URL=https://92-222-70-138.sslip.io


# Ancienne clé partagée X-API-Key — plus utilisée comme garde (auth = JWT).
# Peut rester vide.
API_KEY=

# Clé API Mistral. https://console.mistral.ai/
MISTRAL_API_KEY=

# ── Base de données (conteneur postgres du docker-compose) ──────────────
POSTGRES_USER=ofacilite
POSTGRES_PASSWORD=
POSTGRES_DB=ofacilite
DATABASE_URL=postgresql://ofacilite:CHANGEME@postgres:5432/ofacilite

# ── Auth ──────────────────────────────────────────────────────────────
# Secret de signature des JWT. Générer : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=90d
# Numéro de connexion du compte administrateur (créé au 1er démarrage).
ADMIN_LOGIN_CODE=

# Taille max d'upload (Mo). Doit rester <= la limite du Caddyfile (10MB).
MAX_UPLOAD_MB=8

# Durée de rétention des photos scannées avant purge automatique (heures).
UPLOAD_TTL_HOURS=24

# Rate limit par IP (fenêtre en ms + nombre de requêtes).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Tag de l'image construite par docker compose.
IMAGE_TAG=latest
