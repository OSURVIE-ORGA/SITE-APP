{
  "expo": {
    "name": "O'Facilit",
    "slug": "osurvie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ofacilite",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "L'app a besoin d'accéder à vos contacts pour passer des appels.",
        "NSCameraUsageDescription": "L'app a besoin de la caméra pour photographier des documents.",
        "NSPhotoLibraryUsageDescription": "L'app a besoin d'accéder à vos photos.",
        "NSLocationWhenInUseUsageDescription": "L'app a besoin de votre position pour afficher les lieux d'aide proches.",
        "NSSpeechRecognitionUsageDescription": "L'app utilise la reconnaissance vocale pour répondre à vos questions.",
        "NSMicrophoneUsageDescription": "L'app a besoin du micro pour la reconnaissance vocale."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5C3D1E",
        "foregroundImage": "./assets/images/logo-react-native.png"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.baji.keusike.ofacilite"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-contacts",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à vos photos pour les partager avec vos contacts.",
          "cameraPermission": "L'app utilise la caméra pour photographier des documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'app utilise la caméra pour scanner vos documents et vous aider à les lire."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alert.mp3"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5C3D1E",
          "image": "./assets/images/icon.png",
          "imageWidth": 100
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9709c8f-db37-4fd2-9ed1-66e34ac8983e"
      }
    }
  }
}