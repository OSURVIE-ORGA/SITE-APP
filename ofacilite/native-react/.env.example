# Copie ce fichier en `.env` (gitignoré) et remplis les valeurs.
# Les variables EXPO_PUBLIC_* sont incluses telles quelles dans le bundle JS
# de l'app — ne mets rien de réellement sensible ici.

# URL de l'API NestJS.
#  - en dev sur simulateur/téléphone : laisse vide, l'app déduit
#    http://<ip-du-pc-expo>:3000
#  - en build (preview / production) : mets l'URL publique
EXPO_PUBLIC_API_URL=https://92-222-70-138.sslip.io

# Clé partagée envoyée dans l'en-tête X-API-Key (doit être = API_KEY du
# .env.production de l'API).
EXPO_PUBLIC_API_KEY=

# La carte utilise OpenStreetMap, aucune clé requise.
